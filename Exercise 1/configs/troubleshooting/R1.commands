! Applied repairs, not full running-config
configure terminal
username R3 password cisco
interface g0/0
 no ip address
interface g0/1
 ip address 10.0.0.1 255.255.255.128
 no shutdown
interface s0/0/0
 ip address 172.16.0.1 255.255.255.252
 encapsulation ppp
 ppp authentication chap
 no shutdown
interface s0/0/1
 ppp authentication chap
 no shutdown
end
write memory
